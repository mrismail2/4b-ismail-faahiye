# KAABE — koobi u samee `.env` ka dibna buuxi
# Qiimayaashu waxay ka yimaadaan: Supabase Dashboard → Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# DIGNIIN: furaha `service_role` HALKAN HA GELIN. Wuxuu RLS oo dhan dhaafaa
# waana in uu ku sii jiro server-ka oo keliya, weligiisna aan la geyn app-ka.
#
# Haddii labadan la banayo, app-ku wuxuu u shaqeeyaa "local mode" — xogtu
# qalabka ayay ku jirtaa (AsyncStorage), tijaabo ahaan.
